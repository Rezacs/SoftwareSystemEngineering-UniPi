{
  "production_system": {
    "host": "127.0.0.1",
    "port": 5006
  },

  "endpoints": {
    "classifier_received": "/classifier",
    "prepared_session_received": "/session",
    "status": "/status"
  },

  "client_side_system": {
    "host": "127.0.0.1",
    "port": 5008,
    "label_endpoint": "/receive-label"
  },

  "evaluation_system": {
    "host": "127.0.0.1",
    "port": 5007,
    "classifier_label_endpoint": "/classifier-label"
  },

  "paths": {
    "classifiers_dir": "Data/classifiers/",
    "latest_classifier": "Data/internal/latest_classifier.json",
    "latest_session": "Data/internal/latest_session.json",
    "status": "Data/internal/status.json",
    "latest_label": "Data/outputs/latest_label.json",
    "evaluation_payload": "Data/outputs/evaluation_payload.json",
    "log": "Data/reports/production_log.json"
  },

  "classification": {
    "feature_columns": [
      "skill_overall",
      "social_influence_score",
      "injuries_impact_score"
    ]
  },

  "evaluation": {
    "enabled": true
  }
}
