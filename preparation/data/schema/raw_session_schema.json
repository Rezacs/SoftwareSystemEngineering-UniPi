{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "UUID",
        "created_at",
        "records"
    ],
    "properties": {
        "UUID": {
            "type": "string"
        },
        "created_at": {
            "type": "string"
        },
        "records": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "UUID",
                    "player_id",
                    "days_missed",
                    "games_missed",
                    "number_of_likes",
                    "number_of_followers",
                    "skill_overall",
                    "label"
                ],
                "properties": {
                    "UUID": { "type": "string" },
                    "player_id": { "type": "integer",
                                    "minimum": 0 },
                    "days_missed": { "type": ["integer", "null"] },
                    "games_missed": { "type": ["integer", "null"] },
                    "number_of_likes": { "type": ["integer", "null"] },
                    "number_of_followers": { "type": ["integer", "null"] },
                    "skill_overall": { "type": ["integer", "null"] },
                    "label": { "type": ["integer","null"],
                               "minimum" : 0,
                               "maximum": 4 }
                }
            }
        }
    }
}